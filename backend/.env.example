# CraveCart Backend Environment Configuration Example
# Copy to .env and replace placeholder values with your local or staging credentials.
# NEVER commit production secrets or credentials.

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database
# If MONGODB_URI is empty or fails to connect, offline mock storage will engage for tests
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.ajejyjz.mongodb.net/cravecart?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=cravecart_super_secure_jwt_secret_token_v2
JWT_EXPIRES_IN=24h

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
RAZORPAY_MODE=test

# Transactional Email (Defaults to mock/Ethereal transport when unconfigured)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CraveCart Notifications <noreply@cravecart.local>

# Real-time Map & Simulation
SIMULATION_INTERVAL_MS=2500

# Optional AI / Gemini API Integration for Chatbot (Gracefully falls back to deterministic RAG engine if unset)
GEMINI_API_KEY=

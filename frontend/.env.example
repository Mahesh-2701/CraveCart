# CraveCart Frontend Environment Configuration Example
# Copy to .env for local development

# Base URL of the CraveCart backend API (defaults to http://localhost:5000)
REACT_APP_API_URL=http://localhost:5000

# WebSocket / Socket.IO Server URL (defaults to http://localhost:5000)
REACT_APP_WS_URL=http://localhost:5000

# Razorpay Test Key ID for Checkout Modal
REACT_APP_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# MapLibre Free Open-Data Map Style URL
REACT_APP_MAP_STYLE=https://demotiles.maplibre.org/style.json
